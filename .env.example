# TokenRouter 控制台提供的密钥（这里只写变量名，不要提交真实 Key）
WORKSHOP_AI_API_KEY=

# 填基础地址，不要重复填写 /chat/completions
WORKSHOP_AI_BASE_URL=https://你的-tokenrouter-地址/v1
WORKSHOP_AI_MODEL=deepseek-chat

# 如果控制台只提供完整请求地址，可以改用这一项：
# WORKSHOP_AI_CHAT_URL=https://你的-tokenrouter-地址/v1/chat/completions

# 少数中转接口不支持 response_format 时设为 false
WORKSHOP_AI_JSON_MODE=true
